    <mxGraphModel dx="2447" dy="2052" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Role {\n        &lt;&lt;enumeration&gt;&gt;\n        ADMIN\n        GESTIONNAIRE\n        UTILISATEUR\n    }\n\n    class StatutMateriel {\n        &lt;&lt;enumeration&gt;&gt;\n        DISPONIBLE\n        INDISPONIBLE\n        ENDOMMAGE\n    }\n\n    class StatutReservation {\n        &lt;&lt;enumeration&gt;&gt;\n        CONFIRMEE\n        EN_COURS\n        TERMINEE\n        ANNULEE\n    }\n\n    class EtatRetour {\n        &lt;&lt;enumeration&gt;&gt;\n        BON_ETAT\n        ENDOMMAGE\n    }\n\n    class AppConfig {\n        +ObjectId id\n        +Boolean isInstalled\n        +Date installedAt\n        +ObjectId installedBy\n        +verifierStatutInstallation() Boolean\n        +initialiserApplication(adminData) User\n    }\n\n    class Magasin {\n        +ObjectId id\n        +String nom\n        +String adresse\n        +String site\n        +Boolean isActive\n        +Date createdAt\n        +Date updatedAt\n        +creer() Magasin\n        +modifier() Magasin\n        +desactiver() void\n    }\n\n    class User {\n        +ObjectId id\n        +String nom\n        +String prenom\n        +String email\n        +String passwordHash\n        +Role role\n        +Boolean isActive\n        +ObjectId magasinId\n        +ObjectId createdBy\n        +Date createdAt\n        +Date updatedAt\n        +seConnecter(email, password) String\n        +modifierProfil(data) User\n        +modifierMotDePasse(ancien, nouveau) void\n        +desactiver() void\n    }\n\n    class Materiel {\n        +ObjectId id\n        +String reference\n        +String nom\n        +String categorie\n        +String description\n        +StatutMateriel statut\n        +Boolean isActive\n        +ObjectId magasinId\n        +Date createdAt\n        +Date updatedAt\n        +declarerIndisponible() void\n        +remettreEnService() void\n        +desactiver() void\n        +estDisponibleSurCreneau(debut, fin) Boolean\n    }\n\n    class Reservation {\n        +ObjectId id\n        +ObjectId userId\n        +ObjectId materielId\n        +ObjectId magasinId\n        +Date dateDebut\n        +Int dureeHeures\n        +Date dateFin\n        +Date dateReelleSortie\n        +StatutReservation statut\n        +Date createdAt\n        +Date updatedAt\n        +creer() Reservation\n        +confirmer() void\n        +annuler() void\n        +demarrerEmprunt() void\n        +terminer() void\n    }\n\n    class Retour {\n        +ObjectId id\n        +ObjectId reservationId\n        +Date dateRetour\n        +EtatRetour etat\n        +String commentaire\n        +Date createdAt\n        +enregistrer() Retour\n        +signalerDommage() void\n    }\n\n    AppConfig \&quot;0..1\&quot; --&gt; \&quot;1\&quot; User : installé par\n    Magasin \&quot;0..1\&quot; o-- \&quot;0..*\&quot; User : accueille\n    User \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; User : crée\n    Magasin \&quot;1\&quot; *-- \&quot;0..*\&quot; Materiel : possède\n    Magasin \&quot;1\&quot; o-- \&quot;0..*\&quot; Reservation : gère\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reservation : effectue\n    Materiel \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reservation : concerne\n    Reservation \&quot;1\&quot; *-- \&quot;0..1\&quot; Retour : génère\n    User ..&gt; Role : role\n    Materiel ..&gt; StatutMateriel : statut\n    Reservation ..&gt; StatutReservation : statut\n    Retour ..&gt; EtatRetour : etat&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="WR_W2tA7ZavJYCg2NoxN-137">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
